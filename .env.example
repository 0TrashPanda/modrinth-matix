# SQLite database file. In Docker this lives on the /data volume.
DATABASE_URL=data/app.db

# Google OAuth client (Google Cloud console > APIs & Services > Credentials > OAuth client ID, type "Web application").
# Authorized redirect URI: <your origin>/login/google/callback, e.g. http://localhost:5173/login/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google account that becomes admin without an invite. If empty, the first account to sign in becomes admin.
ADMIN_EMAIL=

# Production only (adapter-node), when running behind nginx:
# ORIGIN=https://matrix.example.com
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
